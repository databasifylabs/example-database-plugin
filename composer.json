{
    "name": "databasifylabs/plugin-example-database",
    "description": "Example Databasify plugin: a community engine with its own driver, running on the engine-template image.",
    "version": "2.0.0",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Databasify\\ExampleDatabase\\": "src/"
        }
    },
    "extra": {
        "databasify": {
            "plugin": "Databasify\\ExampleDatabase\\ExampleDatabasePlugin",
            "requires": "^0.2",
            "icon": "icon.svg",
            "engines": [
                "example"
            ]
        }
    }
}
