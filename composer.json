{
    "name": "databasifylabs/plugin-example-database",
    "description": "Example Databasify plugin: a caching engine registered on the official Valkey engine image.",
    "version": "1.0.0",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Databasify\\ExampleDatabase\\": "src/"
        }
    },
    "extra": {
        "databasify": {
            "plugin": "Databasify\\ExampleDatabase\\ExampleDatabasePlugin",
            "requires": "^0.1",
            "icon": "icon.svg",
            "engines": [
                "example-cache"
            ]
        }
    }
}
